[Unit]
Description=Internal helper service for credentialsd

[Service]
Type=dbus
BusName=xyz.iinuwa.credentialsd.UiControl
ExecStart=@UI_EXECUTABLE@

# Hardening
#
# Like the daemon, no options that need a private mount namespace: the UI calls
# other portals (e.g. Settings for the colour scheme), and xdg-desktop-portal
# identifies its callers through /proc/<pid>/root. MemoryDenyWriteExecute= is left out because GTK's GL
# renderer may run on a JIT-compiling driver such as llvmpipe.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# memfd_secret: PINs are passed over D-Bus in memfd_secret file descriptors.
SystemCallFilter=memfd_secret
SystemCallErrorNumber=EPERM
# AF_UNIX: D-Bus and the Wayland/X11 display. AF_NETLINK: GLib's network
# monitor.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
UMask=0077

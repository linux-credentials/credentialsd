[Unit]
Description=Service for creating and storing user credentials

[Service]
Type=dbus
BusName=xyz.iinuwa.credentialsd.Credentials
ExecStart=@DAEMON_EXECUTABLE@

# Hardening
#
# credentialsd decides whether a caller is trusted partly by comparing its own
# mount namespace with the caller's. Options that give the service a private
# mount namespace (ProtectSystem=, ProtectHome=, PrivateTmp=, PrivateDevices=,
# ProtectKernelTunables=, ...) would make it reject xdg-desktop-portal, so only
# options enforced through seccomp and no_new_privs are used. They also work in
# the user service manager without user namespaces.
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# memfd_secret: the hybrid QR code secret are passed over D-Bus in memfd_secret file descriptors.
SystemCallFilter=memfd_secret
SystemCallErrorNumber=EPERM
# AF_UNIX: D-Bus (including BlueZ) and pcscd. AF_NETLINK: udev device
# monitoring. AF_INET/AF_INET6: the hybrid tunnel to the phone's relay server.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
UMask=0077

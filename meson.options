# Compile options

option(
  'profile',
  type: 'combo',
  choices: ['release', 'development'],
  value: 'release',
  description: 'The build profile for the targets. To relax the security checks for development, see `enable_trusted_client_overrides`.',
)
option(
  'cargo_home',
  type: 'string',
  description: 'The directory to store files downloaded by Cargo',
)
option(
  'cargo_locked',
  type: 'boolean',
  value: false,
  description: 'Whether Cargo.lock will be used without modification. Defaults to false to automatically resolve dependencies.',
)
option(
  'cargo_offline',
  type: 'boolean',
  value: false,
  description: 'Whether to perform an offline build with Cargo. Defaults to false to download crates from registries.',
)
option(
  'enable_core_dumps',
  type: 'boolean',
  value: false,
  description: 'Allow credentialsd-ui to write core dumps, for debugging crashes. Defaults to false because the UI handles PINs typed by the user.',
)
option(
  'enable_trusted_client_overrides',
  type: 'boolean',
  value: false,
  description: 'Let the CREDSD_TRUSTED_CALLERS and CREDSD_TRUSTED_APP_IDS environment variables add trusted callers and privileged app IDs to the daemon, for development. Defaults to false because any process in the user session could then request credentials for any origin.',
)

# Features
option(
  'feature_daemon',
  type: 'feature',
  value: 'enabled',
  description: 'Whether to build the credentialsd daemon',
)

option(
  'feature_demo_client',
  type: 'feature',
  value: 'auto',
  description: 'Whether to build the demo client',
)

option(
  'feature_gui',
  type: 'feature',
  value: 'enabled',
  description: 'Whether to build the credentialsd-ui GUI',
)

option(
  'feature_web_extension',
  type: 'feature',
  value: 'enabled',
  description: 'Whether to build the web extension',
)

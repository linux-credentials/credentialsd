# Compile options

option(
  'profile',
  type: 'combo',
  choices: ['release', 'development'],
  value: 'release',
  description: 'The build profile for the targets. The `development` profile also allows disabling some security checks for easier development.',
)
option(
  'cargo_home',
  type: 'string',
  description: 'The directory to store files downloaded by Cargo',
)
option(
  'cargo_locked',
  type: 'boolean',
  value: false,
  description: 'Whether Cargo.lock will be used without modification. Defaults to false to automatically resolve dependencies.',
)
option(
  'cargo_offline',
  type: 'boolean',
  value: false,
  description: 'Whether to perform an offline build with Cargo. Defaults to false to download crates from registries.',
)

# Features
option(
  'feature_daemon',
  type: 'feature',
  value: 'auto',
  description: 'Whether to build the credentialsd daemon',
)

option(
  'feature_demo_client',
  type: 'feature',
  value: 'auto',
  description: 'Whether to build the demo client',
)

option(
  'feature_gui',
  type: 'feature',
  value: 'enabled',
  description: 'Whether to build the credentialsd-ui GUI',
)

option(
  'feature_web_extension',
  type: 'feature',
  value: 'enabled',
  description: 'Whether to build the web extension',
)
